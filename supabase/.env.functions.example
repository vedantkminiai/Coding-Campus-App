# Copy this file to `.env.functions`, then replace the placeholders.
# `.env.functions` is intentionally ignored by Git.

JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=replace_with_your_rapidapi_key
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-5-mini
# Optional separate model for the admin curriculum cleanup pipeline.
# OPENAI_CLEANUP_MODEL=gpt-5-mini

# Optional: pin language IDs if your Judge0 instance uses custom IDs.
# JUDGE0_LANGUAGE_PYTHON=71
# JUDGE0_LANGUAGE_CPP=54
# JUDGE0_LANGUAGE_JAVA=62
